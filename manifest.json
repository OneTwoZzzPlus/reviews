{
    "manifest_version": 3,
    "name": "Reviews",
    "version": "0.3.0",
    "description": "Показывает отзывы о преподавателях на сайте университета",
    "permissions": ["storage"],
    "host_permissions": ["https://reviews.work.gd/*"],
    "icons": {
        "16": "icons/16.png",
        "32": "icons/32.png",
        "48": "icons/48.png",
        "128": "icons/128.png"
    },
    "action": {
        "default_popup": "popup.html"
    },
    "content_scripts": [
        {
            "matches": ["https://my.itmo.ru/*", "https://dev.my.itmo.su/*"],
            "js": ["injector.js"],
            "css": ["styles.css"],
            "all_frames": true,
            "run_at": "document_idle"
        }
    ]
}
